# Required to encrypt LinkedIn OAuth tokens. Keep unchanged after connecting accounts.
APP_ENCRYPTION_KEY=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://YOUR-RENDER-SERVICE.onrender.com/auth/linkedin/callback
LINKEDIN_API_VERSION=202607

# At least one text-generation provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3-235b-a22b-instruct

# Optional paid image API (current image endpoint uses OpenAI)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Database and scheduler
DATABASE_URL=sqlite:///./content_studio.db
APP_TIMEZONE=Asia/Kolkata
ENABLE_SCHEDULER=true
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
